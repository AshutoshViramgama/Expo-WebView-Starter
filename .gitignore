# ─────────────────────────────────────────────────────────
#  Git ignore rules for the WebView Starter App
# ─────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Environment variables — NEVER commit .env
.env
# .env.example is intentionally tracked

# Native build outputs
ios/
android/
*.ipa
*.apk
*.aab

# Metro bundler cache
.metro-health-check*

# macOS
.DS_Store
*.pem

# Editor
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
