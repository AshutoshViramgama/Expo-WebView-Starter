# ─────────────────────────────────────────────────────────
#  WebView Starter App – Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# The URL the WebView loads on first launch (required).
APP_BASE_URL=https://example.com

# Comma-separated list of domains allowed for in-app navigation.
# Leave blank to auto-detect from APP_BASE_URL.
APP_ALLOWED_DOMAINS=example.com,www.example.com

# Runtime environment: development | staging | production
APP_ENV=development
